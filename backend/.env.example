# ============================================
# ALANTEK — Variables de entorno (ejemplo)
# Copiar a `.env` y completar con valores reales.
# NUNCA subir el .env real al repositorio.
# ============================================

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/portfolio_db?schema=public"

# JWT (claves aleatorias de al menos 32 caracteres)
JWT_SECRET=genera-una-clave-aleatoria-aqui
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=genera-otra-clave-aleatoria-aqui
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=20971520

# CORS (separados por coma, sin espacios)
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=admin@portfolio.com

# GitHub / GitLab (opcional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Rate Limit
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Seed (credenciales del usuario administrador inicial)
SEED_ADMIN_EMAIL=admin@portfolio.com
SEED_ADMIN_PASSWORD=Admin123!
