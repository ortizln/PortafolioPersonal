# ============================================
# ALANTEK — Variables de producción (ejemplo)
# Copiar a `.env` en el servidor y completar con
# valores REALES. NUNCA subir el .env real al repo.
# ============================================

# PostgreSQL (usuario:clave@host:puerto/db)
DATABASE_URL=postgresql://postgres:TU_CLAVE_REAL@192.168.1.43:5432/portfolio_db?schema=public

# JWT (generar claves largas y aleatorias)
JWT_SECRET=genera-una-clave-aleatoria-de-64-caracteres-aqui
JWT_REFRESH_SECRET=genera-otra-clave-aleatoria-diferente-aqui

# CORS (dominios permitidos, separados por coma, sin espacios)
CORS_ORIGIN=http://192.168.1.43

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Uploads
MAX_FILE_SIZE=20971520
UPLOAD_PATH=./uploads

# SMTP (correo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=admin@alantek.com
